---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="Ateliers Cuisine - Blablacooks"
  description="Participez à nos ateliers de cuisine interculturelle à Montpellier. Découvrez des recettes du monde entier, cuisinez ensemble et partagez un repas convivial."
>

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO SECTION
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>

    <div class="container">
      <div class="page-hero-grid">
        <div class="page-hero-content">
          <span class="label label-terracotta">Ateliers Cuisine</span>
          <h1>Enfilez vos tabliers !</h1>
          <p class="page-hero-desc">
            Blablacooks vous propose des ateliers de cuisine participative avec des cuistots du monde entier. Découvrez de nouvelles saveurs, rencontrez des personnes passionnantes et partagez un repas convivial.
          </p>
        </div>

        <div class="page-hero-image">
          <img src="/vrais-photos/a propos-5.png" alt="Atelier de cuisine Blablacooks" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       COMMENT CA SE PASSE
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="how-it-works section">
    <div class="container">
      <div class="section-header section-header-spaced" data-animate>
        <span class="label label-gold">Le déroulement</span>
        <h2>Comment ça se passe ?</h2>
      </div>

      <div class="steps-grid">
        <div class="step-card" data-animate>
          <div class="step-icon">
            <img src="/icons/noun-cooking-pot-6972194.svg" alt="" />
          </div>
          <div class="step-number">1</div>
          <h3>Préparation & Cuisson</h3>
          <p>Pendant 2 heures, vous apprenez à réaliser une recette venue d'ailleurs, guidé par un.e cuistot passionné.e.</p>
        </div>

        <div class="step-card" data-animate>
          <div class="step-icon">
            <img src="/icons/noun-dining-6972190.svg" alt="" />
          </div>
          <div class="step-number">2</div>
          <h3>Repas partagé</h3>
          <p>On déguste ensemble ce qu'on a préparé. C'est le moment d'échanger, de discuter et de faire connaissance.</p>
        </div>

        <div class="step-card" data-animate>
          <div class="step-icon">
            <img src="/icons/rangement-convivial.svg" alt="" />
          </div>
          <div class="step-number">3</div>
          <h3>Rangement convivial</h3>
          <p>Vaisselle et rangement ensemble, dans la bonne humeur. L'atelier dure environ 3 heures au total.</p>
        </div>
        </div>
      </div>

      <div class="bring-postit" data-animate>
        <h3>Pensez à apporter</h3>
        <div class="bring-items">
          <div class="bring-item">
            <img src="/icons/noun-recipe-book-5037133.svg" alt="" />
            <span>Un carnet pour noter la recette</span>
          </div>
          <div class="bring-item">
            <img src="/icons/noun-scrunchie-1841573.svg" alt="" />
            <span>Un élastique (cheveux longs)</span>
          </div>
          <div class="bring-item">
            <img src="/icons/chaussures-fermees.svg" alt="" />
            <span>Des chaussures fermées</span>
          </div>
          <div class="bring-item">
            <img src="/icons/noun-tupperware-5257278.svg" alt="" />
            <span>Un tupperware pour les restes</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CE QUE VOUS ALLEZ VIVRE
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="experience section-lg">
    <div class="container">
      <div class="section-header section-header-spaced" data-animate>
        <span class="label label-gold">L'expérience</span>
        <h2>Ce que vous allez vivre</h2>
      </div>

      <div class="exp-two-cards">
        <!-- Participants -->
        <div class="exp-bigcard exp-bigcard-terracotta" data-animate>
          <h3>Pour vous, participants</h3>
          <div class="exp-items">
            <div class="exp-item">
              <img src="/perso-tabliers-bleus/1.webp" alt="" class="exp-illus" />
              <p>Découvrir une autre culture à travers sa cuisine</p>
            </div>
            <div class="exp-item">
              <img src="/perso-tabliers-bleus/2.webp" alt="" class="exp-illus" />
              <p>Apprendre une nouvelle recette venue d'un des 5 continents</p>
            </div>
            <div class="exp-item">
              <img src="/perso-tabliers-bleus/3.webp" alt="" class="exp-illus" />
              <p>Participer à l'accueil d'un.e nouvel.le arrivant.e en France</p>
            </div>
            <div class="exp-item">
              <img src="/perso-tabliers-bleus/4.webp" alt="" class="exp-illus" />
              <p>Partager un moment convivial et enrichissant</p>
            </div>
          </div>
        </div>

        <!-- Cuistots -->
        <div class="exp-bigcard exp-bigcard-gold" data-animate>
          <h3>Pour les cuistots</h3>
          <div class="exp-items">
            <div class="exp-item">
              <img src="/perso-nationalites/Marocaine.webp" alt="" class="exp-illus" />
              <p>Pratiquer le français et gagner en confiance</p>
            </div>
            <div class="exp-item">
              <img src="/perso-nationalites/Senegalaise.webp" alt="" class="exp-illus" />
              <p>Valoriser sa culture à travers un savoir-faire culinaire</p>
            </div>
            <div class="exp-item">
              <img src="/perso-nationalites/Ukrainienne.webp" alt="" class="exp-illus" />
              <p>Rencontrer des Héraultais et créer des liens</p>
            </div>
            <div class="exp-item">
              <img src="/perso-nationalites/Thailandaise.webp" alt="" class="exp-illus" />
              <p>Être rémunéré.e via chèque emploi associatif</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       HISTORIQUE DES ATELIERS
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="past-workshops section-lg">
    <div class="container">
      <div class="section-header section-header-spaced" data-animate>
        <span class="label label-gold">Retour en images</span>
        <h2>Nos Ateliers Passés</h2>
        <p class="section-desc">Découvrez les saveurs que nous avons explorées ensemble</p>
      </div>

      <div class="mosaic-grid">
        <article class="mosaic-item" data-animate data-gallery="tropisme-juin-2026" data-count="9">
          <img src="/vrais-photos/ateliers/tropisme-juin-2026/1.jpg" alt="Journée Mondiale des personnes Réfugiées au Café Tropisme" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 9</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Journée Mondiale des personnes Réfugiées</span>
            <span class="mosaic-date">Juin 2026</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="palestinien-2026" data-count="10">
          <img src="/vrais-photos/ateliers/palestinien-2026/1.jpg" alt="Cuisine Palestinienne Végétarienne" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 10</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Palestinienne Végétarienne</span>
            <span class="mosaic-date">Mars 2026</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="camerounais-2026" data-count="6">
          <img src="/vrais-photos/ateliers/camerounais-2026/6.jpg" alt="Brunch Camerounais" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Brunch Camerounais</span>
            <span class="mosaic-date">Fév 2026</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="afghan-2025" data-count="6">
          <img src="/vrais-photos/ateliers/afghan-2025/3.jpg" alt="Mantus Afghans" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Mantus Afghans</span>
            <span class="mosaic-date">Déc 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate>
          <img src="/vrais-photos/atelier ukrainien passé2.jpeg" alt="Festin Ukrainien et Géorgien" loading="lazy" />
          <div class="mosaic-overlay">
            <span class="mosaic-title">Festin Ukrainien et Géorgien</span>
            <span class="mosaic-date">Oct 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate>
          <img src="/vrais-photos/atelier-camerounais.jpg" alt="Cuisine Camerounaise" loading="lazy" />
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Camerounaise</span>
            <span class="mosaic-date">Sept 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate>
          <img src="/vrais-photos/atelier-bresilien.jpg" alt="Cuisine Brésilienne" loading="lazy" />
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Brésilienne</span>
            <span class="mosaic-date">Mai 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate>
          <img src="/vrais-photos/atelier-turc.jpg" alt="Menu de Thé Turc" loading="lazy" />
          <div class="mosaic-overlay">
            <span class="mosaic-title">Menu de Thé Turc</span>
            <span class="mosaic-date">Avr 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate>
          <img src="/vrais-photos/atelier-caraibes.jpg" alt="Cuisine des Caraïbes" loading="lazy" />
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine des Caraïbes</span>
            <span class="mosaic-date">Mars 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="ukrainien-anna-2025" data-count="6">
          <img src="/vrais-photos/ateliers/ukrainien-anna-2025/1.jpg" alt="Cuisine Ukrainienne" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Ukrainienne</span>
            <span class="mosaic-date">Fév 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="bresilien-2025" data-count="6">
          <img src="/vrais-photos/ateliers/bresilien-2025/1.jpg" alt="Cuisine Brésilienne" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Brésilienne</span>
            <span class="mosaic-date">Fév 2025</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="roumain-2024" data-count="6">
          <img src="/vrais-photos/ateliers/roumain-2024/1.jpg" alt="Cuisine Roumaine" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Roumaine</span>
            <span class="mosaic-date">Déc 2024</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="libanais-2024" data-count="6">
          <img src="/vrais-photos/ateliers/libanais-2024/6.jpg" alt="Cuisine Libanaise" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 6</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Libanaise</span>
            <span class="mosaic-date">Nov 2024</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="senegal-2023" data-count="5">
          <img src="/vrais-photos/ateliers/senegal-2023/2.jpg" alt="Cuisine Sénégalaise" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 5</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Sénégalaise</span>
            <span class="mosaic-date">Oct 2023</span>
          </div>
        </article>
        <article class="mosaic-item" data-animate data-gallery="ivoirien-2023" data-count="3">
          <img src="/vrais-photos/ateliers/ivoirien-2023/2.jpg" alt="Cuisine Ivoirienne" loading="lazy" />
          <span class="mosaic-gallery-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 3</span>
          <div class="mosaic-overlay">
            <span class="mosaic-title">Cuisine Ivoirienne</span>
            <span class="mosaic-date">Mars 2023</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="Fermer">&times;</button>
    <button class="lightbox-prev" aria-label="Précédent">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
      <div class="lightbox-counter" id="lightbox-counter"></div>
    </div>
    <button class="lightbox-next" aria-label="Suivant">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       DEVENIR CUISTOT
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="become-cook">
    <div class="container">
      <div class="become-cook-inner" data-animate>
        <h2>Devenir cuistot Blablacooks</h2>
        <p class="become-cook-intro">
          Vous venez d'une autre culture et vous aimez cuisiner ? Partagez un plat de votre pays avec des Montpelliérains curieux.
        </p>
        <div class="become-cook-details">
          <div class="become-cook-detail">
            <img src="/icons/noun-discussion-5037129.svg" alt="" class="become-cook-icon" />
            <div>
              <strong>Prérequis</strong>
              <span>Français A1 minimum, situation légale de travail</span>
            </div>
          </div>
          <div class="become-cook-detail">
            <img src="/icons/noun-finance-8238945.svg" alt="" class="become-cook-icon" />
            <div>
              <strong>Rémunération</strong>
              <span>5h au SMIC (courses, atelier, repas, rangement)</span>
            </div>
          </div>
          <div class="become-cook-detail">
            <img src="/icons/noun-cooking-academy-5381426.svg" alt="" class="become-cook-icon" />
            <div>
              <strong>Formation</strong>
              <span>3 demi-journées d'accompagnement avant l'atelier</span>
            </div>
          </div>
          <div class="become-cook-detail">
            <img src="/icons/noun-cooking-pot-6972194.svg" alt="" class="become-cook-icon" />
            <div>
              <strong>Ingrédients</strong>
              <span>Pris en charge par l'association</span>
            </div>
          </div>
        </div>
        <a href="mailto:blablacooks@gmail.com" class="btn become-cook-btn">
          Nous contacter
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     SECTION HEADERS
  ═══════════════════════════════════════════════════════════════════ */
  .section-header-spaced {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header-spaced .label {
    margin-bottom: var(--space-sm);
  }

  .section-header-spaced h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .section-header-spaced .section-desc {
    color: var(--color-brown);
    opacity: 0.7;
    margin-top: var(--space-xs);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header-light h2 {
    color: white;
  }

  .section-header-light .section-desc {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ═══════════════════════════════════════════════════════════════════
     PAGE HERO
  ═══════════════════════════════════════════════════════════════════ */
  .page-hero {
    position: relative;
    padding: calc(100px + var(--space-xl)) 0 var(--space-2xl);
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero-bg .blob-1 {
    width: 500px;
    height: 500px;
    top: -150px;
    right: -150px;
  }

  .page-hero-bg .blob-2 {
    width: 300px;
    height: 300px;
    bottom: -50px;
    left: -100px;
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
  }

  .page-hero-content h1 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .page-hero-desc {
    font-size: 1.2rem;
    color: var(--color-brown);
    margin-bottom: var(--space-lg);
    max-width: 500px;
  }

  .page-hero-image {
    position: relative;
  }

  .page-hero-image img {
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-elevated);
  }

  /* ═══════════════════════════════════════════════════════════════════
     HOW IT WORKS
  ═══════════════════════════════════════════════════════════════════ */
  .how-it-works {
    background: white;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    max-width: 1000px;
    margin: 0 auto;
  }

  .step-card {
    text-align: center;
    padding: var(--space-lg);
  }

  .step-icon {
    width: 80px;
    height: 80px;
    background: var(--color-cream-dark);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-md);
    overflow: hidden;
    flex-shrink: 0;
  }

  .step-icon img {
    width: 40px;
    height: 40px;
    max-width: 40px;
    max-height: 40px;
    display: block;
    filter: brightness(0) saturate(100%) invert(31%) sepia(95%) saturate(904%) hue-rotate(342deg) brightness(94%) contrast(87%);
  }

  .step-number {
    width: 32px;
    height: 32px;
    background: var(--color-terracotta);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0 auto var(--space-sm);
  }

  .step-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .step-card p {
    color: var(--color-brown);
    opacity: 0.7;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ═══════════════════════════════════════════════════════════════════
     EXPERIENCE SECTION
  ═══════════════════════════════════════════════════════════════════ */
  .experience {
    position: relative;
    background: var(--color-cream-dark);
  }

  .exp-two-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    max-width: 1000px;
    margin: 0 auto;
  }

  .exp-bigcard {
    background: white;
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    box-shadow: var(--shadow-soft);
    border-top: 4px solid transparent;
  }

