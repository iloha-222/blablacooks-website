---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="Blablacooks - Les ateliers qui font parler"
  description="Blablacooks propose des ateliers de cuisine participative, couture et français interculturel à Montpellier. Rejoignez-nous pour partager, apprendre et créer des liens."
>

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO SECTION - Asymmetric composition with floating characters
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <!-- Background elements -->
    <div class="hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="hero-pattern"></div>
    </div>

    <div class="hero-container">
      <!-- Left content -->
      <div class="hero-content">
        <span class="hero-label animate-fade-up">Association interculturelle • Montpellier</span>
        <h1 class="hero-title animate-fade-up delay-1">
          Les ateliers<br/>
          <span class="hero-title-accent">qui font parler</span>
        </h1>
        <p class="hero-desc animate-fade-up delay-2">
          Découvrez la cuisine, la couture à travers le prisme de l'échange interculturel en français. Partagez, apprenez, rencontrez.
        </p>
        <div class="hero-actions animate-fade-up delay-3">
          <a href="#activites" class="btn btn-primary">
            Découvrir nos ateliers
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/a-propos" class="btn btn-secondary">En savoir plus</a>
        </div>
      </div>

      <!-- Right: Character illustration composition -->
      <div class="hero-visual">
        <div class="hero-characters">
          <!-- Quinconce: 3 en haut, 3 en bas -->
          <div class="char-row char-row-top">
            <div class="char animate-float">
              <img src="/perso-nationalites/homme-blond-cuisine.webp" alt="" />
            </div>
            <div class="char animate-float-delayed">
              <img src="/perso-nationalites/Japonaise.webp" alt="" />
            </div>
            <div class="char animate-float">
              <img src="/perso-nationalites/femme-couture.webp" alt="" />
            </div>
          </div>
          <div class="char-row char-row-bottom">
            <div class="char animate-float-delayed">
              <img src="/perso-nationalites/Ivoirien.webp" alt="" />
            </div>
            <div class="char animate-float">
              <img src="/perso-nationalites/homme-couture.webp" alt="" />
            </div>
            <div class="char animate-float-delayed">
              <img src="/perso-nationalites/Bresilienne.webp" alt="" />
            </div>
          </div>
        </div>

        <!-- Decorative circle behind -->
        <div class="hero-decor">
          <div class="decor-circle-bg"></div>
        </div>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       MISSION SECTION - Full-width statement with photos
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="mission">
    <div class="mission-bg grain"></div>

    <div class="container">
      <div class="mission-content" data-animate>
        <div class="mission-icon">
          <img src="/icons/noun-globe-6688733.svg" alt="" width="48" height="48" />
        </div>
        <h2 class="mission-title">
          Créer des ponts entre les cultures, un atelier à la fois
        </h2>
        <div class="divider divider-center"></div>
        <p class="mission-text">
          Blablacooks favorise la création de liens interculturels et participe à l'inclusion sociale par la mise en lumière et le partage des richesses culturelles et des savoir-faire des nouveaux arrivants dans la région de Montpellier.
        </p>
      </div>

      <!-- Photo mosaic -->
      <div class="mission-photos" data-animate>
        <div class="photo-card photo-1">
          <img src="/vrais-photos/a propos.jpg" alt="Atelier de cuisine" />
          <div class="photo-overlay"></div>
        </div>
        <div class="photo-card photo-2">
          <img src="/vrais-photos/a propos-.webp" alt="Participants" />
          <div class="photo-overlay"></div>
        </div>
        <div class="photo-card photo-3">
          <img src="/vrais-photos/couture-4.jpg" alt="Atelier de couture" />
          <div class="photo-overlay"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       ACTIVITIES SECTION - 3 distinctive cards
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="activites" class="activities section-lg">
    <div class="container">
      <div class="section-header">
        <span class="label label-terracotta">Nos activités</span>
        <h2>2 façons de se rencontrer et un cours de Français Langue Étrangère</h2>
        <p class="section-desc">Chaque atelier est une invitation au voyage et à l'échange</p>
      </div>

      <div class="activities-grid">
        <!-- Cuisine Card -->
        <a href="/ateliers-cuisine" class="activity-card activity-cuisine" data-animate>
          <div class="activity-visual">
            <div class="activity-img-wrapper">
              <img src="/vrais-photos/ateliers/palestinien-2026/4.jpg" alt="Atelier cuisine" class="activity-img" loading="lazy" />
            </div>
            <div class="activity-badge">Cuisine</div>
          </div>
          <div class="activity-content">
            <h3>Ateliers Cuisine</h3>
            <p>Explorez les saveurs du monde avec des personnes venues des 4 coins du globe. Chaque atelier est un voyage culinaire.</p>
            <div class="activity-tags">
              <span>Brésil</span>
              <span>Cameroun</span>
              <span>Ukraine</span>
              <span>+15</span>
            </div>
            <span class="activity-link">
              Découvrir les ateliers
              <span class="arrow">→</span>
            </span>
          </div>
        </a>

        <!-- Couture Card -->
        <a href="/ateliers-couture" class="activity-card activity-couture" data-animate>
          <div class="activity-visual">
            <div class="activity-img-wrapper">
              <img src="/vrais-photos/couture-1.jpg" alt="Atelier couture" class="activity-img" loading="lazy" />
            </div>
            <div class="activity-badge">Couture</div>
          </div>
          <div class="activity-content">
            <h3>Ateliers Couture</h3>
            <p>Initiez-vous à la couture dans un groupe interculturel. Créez, apprenez et partagez dans une ambiance conviviale.</p>
            <div class="activity-tags">
              <span>Initiation</span>
              <span>Réparation</span>
              <span>Création</span>
            </div>
            <span class="activity-link">
              Voir les ateliers
              <span class="arrow">→</span>
            </span>
          </div>
        </a>

        <!-- Français Card -->
        <a href="/francais-interculturel" class="activity-card activity-francais" data-animate>
          <div class="activity-visual">
            <div class="activity-img-wrapper">
              <img src="/vrais-photos/fle-3.jpg" alt="Atelier français" class="activity-img" loading="lazy" />
            </div>
            <div class="activity-badge">Français</div>
          </div>
          <div class="activity-content">
            <h3>Français Interculturel</h3>
            <p>Pratiquez le français dans un cadre convivial et multiculturel. Conversation, échanges et bienveillance.</p>
            <div class="activity-tags">
              <span>Niveau A1</span>
              <span>Conversation</span>
              <span>Échange</span>
            </div>
            <span class="activity-link">
              En savoir plus
              <span class="arrow">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       UPCOMING EVENTS - Featured next workshops
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="upcoming-home section">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-terracotta">À venir</span>
        <h2>Prochain événement</h2>
      </div>
      <a href="/ateliers-cuisine#prochain" class="upcoming-home-card" data-animate>
        <div class="uhc-image">
          <img src="/vrais-photos/evenements/tropisme-juin-2026/groupe.jpg" alt="Soirée Journée Mondiale des Réfugiés" loading="lazy" />
          <span class="uhc-badge">Soirée unique</span>
        </div>
        <div class="uhc-content">
          <span class="uhc-date">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Vendredi 19 juin 2026
          </span>
          <h3>Journée Mondiale des personnes Réfugiées</h3>
          <p>Soirée de gastronomie interculturelle au Café Tropisme — cuisines soudanaise, birmane et afghane.</p>
          <div class="uhc-tags">
            <span>Soudanais</span><span>Birman</span><span>Afghan</span>
          </div>
          <span class="uhc-link">Voir l'événement →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       PAST EVENTS - Recent workshops with details
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="past-events section">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-sage">Retour en images</span>
        <h2>Nos derniers événements</h2>
      </div>

      <div class="past-slider">
        <button class="slider-btn slider-prev" aria-label="Précédent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="past-track">
        <!-- Event 0 - Cuisine Palestinienne -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/ateliers/palestinien-2026/6.jpg" alt="Cuisine Palestinienne Végétarienne" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">22 Mars 2026</span>
            <h3>Cuisine Palestinienne Végétarienne</h3>
            <p>Soupe de lentilles corail, houmous, moutabal et kunefe au fromage et à l'eau de rose. Avec Sawal, co-animé par Hinde Massaoudi.</p>
          </div>
        </article>

        <!-- Event 1 - Brunch Camerounais -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/ateliers/camerounais-2026/6.jpg" alt="Brunch Camerounais" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">8 Février 2026</span>
            <h3>Brunch Camerounais</h3>
            <p>Beignets de haricots croustillants et bouillie crémeuse, tradition matinale d'Afrique de l'Ouest. Avec Adèle Nguelefack.</p>
          </div>
        </article>

        <!-- Event 1 -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/ateliers/afghan-2025/3.jpg" alt="Mantus Afghans" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">7 Décembre 2025</span>
            <h3>Brunch de Fête Afghan</h3>
            <p>Mantus, raviolis à la viande et aux épices avec sauce au yaourt, et ferni aux pistaches. Avec Fawzia Rahmani.</p>
          </div>
        </article>

        <!-- Event 2 -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/atelier ukrainien passé2.jpeg" alt="Festin Ukrainien et Géorgien" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">12 Octobre 2025</span>
            <h3>Festin Ukrainien & Géorgien</h3>
            <p>Salade d'automne, sauce rouge épicée aux prunes, tortore et roulés d'aubergines aux noix. Avec Natalia Bieliakova.</p>
          </div>
        </article>

        <!-- Event 3 -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/atelier-camerounais.jpg" alt="Cuisine Camerounaise" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">21 Septembre 2025</span>
            <h3>Cuisine Camerounaise</h3>
            <p>Poulet DG à la banane plantain et aux épices, accompagné d'un bissap hibiscus et gingembre. Avec Yaya Ngouowoud.</p>
          </div>
        </article>

        <!-- Event 4 -->
        <article class="past-card" data-animate>
          <div class="past-image">
            <img src="/vrais-photos/atelier-bresilien.jpg" alt="Cuisine Brésilienne" class="pos-center" loading="lazy" />
          </div>
          <div class="past-body">
            <span class="past-date">18 Mai 2025</span>
            <h3>Cuisine Brésilienne</h3>
            <p>Moqueca de Salvador de Bahia, accompagnée de riz, Farofa et vinegrate. Avec Eloa Sena et Anaïs Josy.</p>
          </div>
        </article>

        </div><!-- end past-track -->
        <button class="slider-btn slider-next" aria-label="Suivant">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div><!-- end past-slider -->
      <div class="slider-dots" id="past-dots"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CTA SECTION - Join us
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="cta-section" id="contact">

    <div class="container">
      <div class="cta-content" data-animate>
        <div class="cta-icon">
          <img src="/icons/noun-group-8132009.svg" alt="" />
        </div>

        <h2>Prêt à rejoindre<br/>l'aventure ?</h2>
        <p>Les ateliers qui font parler. Favoriser la création de liens interculturels en français par le partage des richesses culturelles et des savoir-faire.</p>

        <div class="cta-actions">
          <a href="/ateliers-cuisine" class="btn btn-primary">
            Voir les ateliers cuisine
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="mailto:blablacooks@gmail.com" class="btn btn-secondary">
            Nous contacter
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const track = document.querySelector('.past-track') as HTMLElement;
  const prevBtn = document.querySelector('.slider-prev') as HTMLButtonElement;
  const nextBtn = document.querySelector('.slider-next') as HTMLButtonElement;
  const dotsContainer = document.getElementById('past-dots');
  const cards = Array.from(track?.querySelectorAll('.past-card') ?? []) as HTMLElement[];

  const PER_PAGE = 2;

  if (track && cards.length) {
    const numPages = Math.ceil(cards.length / PER_PAGE);

    // Build dots (one per page)
    for (let i = 0; i < numPages; i++) {
      const dot = document.createElement('button');
      dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `Page ${i + 1}`);
      dot.addEventListener('click', () => scrollToPage(i));
      dotsContainer?.appendChild(dot);
    }

    const dots = Array.from(dotsContainer?.querySelectorAll('.slider-dot') ?? []) as HTMLElement[];

    function getCurrentPage() {
      const cardWidth = cards[0].offsetWidth;
      const gap = 16;
      return Math.round(track.scrollLeft / ((cardWidth + gap) * PER_PAGE));
    }

    function scrollToPage(p: number) {
      const cardIdx = p * PER_PAGE;
      const card = cards[Math.min(cardIdx, cards.length - 1)];
      track.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
    }

    function updateState() {
      const p = getCurrentPage();
      dots.forEach((d, j) => d.classList.toggle('active', j === p));
      if (prevBtn) prevBtn.disabled = p === 0;
      if (nextBtn) nextBtn.disabled = p >= numPages - 1;
    }

    prevBtn?.addEventListener('click', () => scrollToPage(Math.max(0, getCurrentPage() - 1)));
    nextBtn?.addEventListener('click', () => scrollToPage(Math.min(numPages - 1, getCurrentPage() + 1)));
    track.addEventListener('scroll', updateState, { passive: true });
    updateState();
  }
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO SECTION
  ═══════════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(80px + var(--space-xl)) 0 var(--space-xl);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-bg .blob-1 {
    width: 600px;
    height: 600px;
    top: -100px;
    right: -200px;
  }

  .hero-bg .blob-2 {
    width: 400px;
    height: 400px;
    bottom: -50px;
    left: -100px;
  }

  .hero-pattern {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background-image: radial-gradient(circle at 2px 2px, var(--color-sand) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.4;
    mask-image: linear-gradient(to left, black, transparent);
  }

  .hero-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-label {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-terracotta);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .hero-title {
    margin-bottom: var(--space-md);
  }

  .hero-title-accent {
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-desc {
    font-size: 1.25rem;
    color: var(--color-brown);
    margin-bottom: var(--space-lg);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-brown-dark);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-taupe);
    margin-top: 0.25rem;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-sand);
  }

  /* Hero Visual - Character Composition */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-characters {
    position: relative;
    z-index: 2;
  }

  .hero-characters {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .char-row {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  .char-row-bottom {
    margin-top: -20px;
  }

  .char {
    filter: drop-shadow(0 10px 25px rgba(92, 74, 61, 0.15));
    transition: transform 0.4s var(--ease-out-expo);
  }

  .char:hover {
    z-index: 10;
  }

  .char img {
    width: 240px;
    height: auto;
  }

  /* Hero decorations */
  .hero-decor {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .decor-circle-bg {
    width: 420px;
    height: 420px;
    border-radius: 50%;
    border: 2px dashed var(--color-sand);
    opacity: 0.5;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-indicator span {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-taupe);
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-terracotta), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 1; transform: scaleY(1); }
    50% { opacity: 0.5; transform: scaleY(0.6); }
  }

  /* ═══════════════════════════════════════════════════════════════════
     MISSION SECTION
  ═══════════════════════════════════════════════════════════════════ */
  .mission {
    position: relative;
    background: var(--color-terracotta);
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }

  .mission-bg {
    position: absolute;
    inset: 0;
  }

  .mission-content {
    position: relative;
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-2xl);
    color: white;
  }

  .mission-icon {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-md);
    opacity: 0.85;
  }

  .mission-icon img {
    filter: brightness(0) invert(1) sepia(1) saturate(0.5) hue-rotate(10deg);
  }

  .mission-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    color: white;
    margin-bottom: var(--space-md);
  }

  .mission .divider {
    background: linear-gradient(90deg, transparent, var(--color-gold-light), transparent);
  }

  .mission-text {
    font-size: 1.15rem;
    line-height: 1.8;
    opacity: 0.9;
    max-width: 650px;
    margin: 0 auto;
  }

  /* Photo mosaic */
  .mission-photos {
