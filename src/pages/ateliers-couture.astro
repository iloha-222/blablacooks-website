---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="Ateliers Couture - Blablacooks"
  description="Apprenez la couture dans une ambiance conviviale à Montpellier. Nos ateliers couture favorisent l'échange et le partage de savoir-faire entre cultures."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-text">
        <span class="label label-gold">Ateliers Couture</span>
        <h1>Blablacouture</h1>
        <p class="hero-subtitle">
          On coud, on cause, on se rencontre. Blablacouture réunit des personnes de tous horizons autour de la couture pour pratiquer le français en situation réelle.
        </p>
        <a href="#prochain-atelier" class="btn btn-primary btn-gold">
          S'inscrire au prochain atelier
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>
      </div>

      <div class="hero-image">
        <div class="hero-image-frame">
          <img src="/vrais-photos/Couture.webp" alt="Atelier Blablacouture" />
        </div>
      </div>
    </div>
  </section>

  <!-- Prochain Atelier -->
  <section id="prochain-atelier" class="section atelier-section">
    <div class="container">
      <div class="atelier-layout">
        <div class="atelier-card">
          <div class="atelier-image">
            <img src="/vrais-photos/couture-atelier.webp" alt="Ateliers Blablacouture" loading="lazy" />
          </div>
          <div class="atelier-content">
            <div class="atelier-badges">
              <span class="badge badge-gold">À venir</span>
              <span class="badge-date">29 Mai → 03 Juillet 2026</span>
            </div>
            <h2>Atelier de Couture Interculturel</h2>
            <p>
              5 vendredis pour s'initier à la couture dans un espace de rencontre interculturelle, avec La Cimade. Animé par une couturière récemment arrivée en France et Irène Velay, couturière montpelliéraine.
            </p>
            <a href="https://www.helloasso.com/associations/blablacooks/evenements/atelier-de-couture-interculturel-l-ete" target="_blank" class="btn btn-primary btn-gold btn-full">
              S'inscrire sur HelloAsso
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="atelier-side">
          <div class="side-card side-card-details">
            <h3>Le format</h3>
            <ul class="detail-list">
              <li>
                <svg class="detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>Vendredis, 9h à 12h</span>
              </li>
              <li>
                <svg class="detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>5 ateliers consécutifs</span>
              </li>
              <li>
                <svg class="detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>6 participants (3 francophones + 3 apprenants)</span>
              </li>
            </ul>
          </div>

          <div class="side-card side-card-tarifs">
            <h3>Tarifs</h3>
            <div class="tarif-row tarif-main">
              <span>5 ateliers + adhésion</span>
              <span class="tarif-price">56 €</span>
            </div>
            <div class="tarif-row">
              <span>Déjà adhérent·e</span>
              <span class="tarif-price">50 €</span>
            </div>
            <p class="tarif-note">Adhésion de 7 € à la Maison Pour Tous incluse (3,50 € pour les ados).</p>
          </div>

          <div class="side-card side-card-equipe">
            <h3>L'équipe</h3>
            <div class="equipe-list">
              <div class="equipe-member">
                <strong>Irène Velay</strong>
                <span>Facilitatrice FLE et coordinatrice</span>
              </div>
              <div class="equipe-member">
                <strong>Couturière de l'été</strong>
                <span>Arrivée récemment, en apprentissage du français</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- En pratique -->
  <section class="section pratique-section">
    <div class="container">
      <div class="pratique-layout">
        <div class="pratique-text">
          <span class="label label-sage">En pratique</span>
          <h2>Où nous trouver</h2>
          <div class="pratique-address">
            <h3>MPT Voltaire</h3>
            <p>3 Square Jean Monnet, 34070 Montpellier</p>
          </div>
          <div class="pratique-transport">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
            <span>Tram Ligne 3, arrêt Voltaire</span>
          </div>
        </div>
        <div class="pratique-map">
          <div class="map-frame">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2889.5!2d3.8647!3d43.6048!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12b6af3c5c7d8e5d%3A0x8f9b7c6d5e4a3b2c!2s3%20Square%20Jean%20Monnet%2C%2034070%20Montpellier!5e0!3m2!1sfr!2sfr!4v1234567890"
              allowfullscreen=""
              loading="lazy"
              title="MPT Voltaire">
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rejoignez l'équipe -->
  <section class="section become-couturier">
    <div class="container">
      <div class="become-couturier-content">
        <h2>Vous savez coudre ?</h2>
        <p>
          On cherche des couturiers et couturières qui veulent transmettre leur savoir-faire dans un cadre interculturel. Bénévolat, bonne humeur et envie de partager.
        </p>
        <a href="mailto:blablacooks@gmail.com" class="btn btn-cta-white">
          Nous contacter
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 120px 0 var(--space-2xl);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-cream-dark) 50%, var(--color-sand) 100%);
  }

  .hero-bg .blob {
    position: absolute;
  }

  .hero-bg .blob-1 {
    width: 600px;
    height: 600px;
    top: -200px;
    right: -150px;
    background: linear-gradient(135deg, rgba(212, 161, 74, 0.12), rgba(245, 182, 17, 0.06));
    animation: blob-morph 20s ease-in-out infinite;
  }

  .hero-bg .blob-2 {
    width: 400px;
    height: 400px;
    bottom: -100px;
    left: -100px;
    background: linear-gradient(135deg, rgba(143, 166, 134, 0.1), rgba(200, 212, 194, 0.05));
    animation: blob-morph 25s ease-in-out infinite reverse;
  }

  .hero-content {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-text {
    max-width: 540px;
  }

  .hero-text h1 {
    margin: var(--space-md) 0;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-brown);
    opacity: 0.8;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .hero-image-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 6px solid white;
    max-width: 480px;
  }

  .hero-image-frame img {
    width: 100%;
    height: auto;
  }

  /* Gold button */
  .btn-gold {
    background: var(--color-gold);
    box-shadow: 0 4px 20px -4px rgba(212, 161, 74, 0.4);
  }

  .btn-gold:hover {
    background: #c99a42;
    box-shadow: 0 8px 30px -4px rgba(212, 161, 74, 0.5);
  }

  .btn-full {
    width: 100%;
    justify-content: center;
  }

  /* Atelier Section */
  .atelier-section {
    background: white;
  }

  .atelier-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-lg);
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .atelier-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-sand);
    box-shadow: var(--shadow-soft);
  }

  .atelier-image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .atelier-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .atelier-content {
    padding: var(--space-md) var(--space-lg);
  }

  .atelier-badges {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .badge {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .badge-gold {
    background: var(--color-gold);
    color: white;
  }

  .badge-date {
    font-size: 0.9rem;
    color: var(--color-brown);
    opacity: 0.6;
  }

  .atelier-content h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    margin-bottom: var(--space-sm);
  }

  .atelier-content > p {
    color: var(--color-brown);
    opacity: 0.75;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    font-size: 1rem;
  }

  /* Side cards */
  .atelier-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .side-card {
    background: var(--color-cream-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-sand);
  }

  .side-card h3 {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brown);
    opacity: 0.6;
    margin-bottom: var(--space-sm);
  }

  .detail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detail-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-brown-dark);
  }

  .detail-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .tarif-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.95rem;
  }

  .tarif-main {
    border-bottom: 1px solid var(--color-sand);
    padding-bottom: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .tarif-main span:first-child {
    font-weight: 600;
    color: var(--color-brown-dark);
  }

  .tarif-price {
    font-weight: 700;
    color: var(--color-terracotta);
  }

  .tarif-note {
    font-size: 0.8rem;
    color: var(--color-brown);
    opacity: 0.5;
    margin-top: var(--space-xs);
    line-height: 1.5;
  }

  /* En pratique */
  .pratique-section {
    background: var(--color-cream-dark);
  }

  .pratique-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-xl);
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .pratique-text .label {
    margin-bottom: var(--space-sm);
  }

  .pratique-text h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .pratique-address {
    margin-bottom: var(--space-md);
  }

  .pratique-address h3 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .pratique-address p {
    color: var(--color-brown);
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .pratique-transport {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-brown);
    opacity: 0.6;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-sand);
  }

  .pratique-transport svg {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  .pratique-map {
    position: sticky;
    top: 100px;
  }

  .map-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-sand);
    aspect-ratio: 4/3;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Equipe side card */
  .equipe-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .equipe-member {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .equipe-member strong {
    font-size: 0.95rem;
    color: var(--color-brown-dark);
  }

  .equipe-member span {
    font-size: 0.85rem;
    color: var(--color-brown);
    opacity: 0.6;
  }

  /* Rejoignez l'équipe */
  .become-couturier {
    background: var(--color-gold);
    text-align: center;
  }

  .become-couturier-content {
    max-width: 520px;
    margin: 0 auto;
  }

  .become-couturier-content h2 {
    color: white;
    margin-bottom: var(--space-md);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .become-couturier-content > p {
    color: white;
    opacity: 0.9;
    margin: 0 auto var(--space-lg);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .btn-cta-white {
    background: white;
    color: var(--color-brown-dark);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.15);
  }

  .btn-cta-white:hover {
    background: var(--color-cream);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px -4px rgba(0, 0, 0, 0.2);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-xl);
    }

    .hero-text {
      max-width: 600px;
      margin: 0 auto;
    }

    .atelier-layout {
      grid-template-columns: 1fr;
    }

    .atelier-side {
      flex-direction: row;
    }

    .side-card {
      flex: 1;
    }

    .pratique-layout {
      grid-template-columns: 1fr;
    }

    .pratique-map {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 100px 0 var(--space-xl);
    }

    .hero-image-frame {
      max-width: 320px;
    }

    .atelier-content {
      padding: var(--space-md);
    }

    .atelier-side {
      flex-direction: column;
    }
  }
</style>
