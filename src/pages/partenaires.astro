---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="Nos Partenaires - Blablacooks"
  description="Découvrez les partenaires de Blablacooks : lieux d'accueil, partenaires financiers et associatifs qui soutiennent nos ateliers interculturels à Montpellier."
>
  <!-- Hero Section -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-animate>
        <span class="label label-terracotta">Notre réseau</span>
        <h1>Nos Partenaires</h1>
        <p class="hero-desc">
          Blablacooks existe grâce à un réseau de lieux d'accueil, de partenaires associatifs et de soutiens financiers qui partagent nos valeurs d'échange et d'inclusion.
        </p>
      </div>
    </div>
    <div class="hero-decoration">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>
  </section>

  <!-- Lieux d'accueil -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-gold">Où nous retrouver</span>
        <h2>Nos lieux d'accueil</h2>
        <div class="divider divider-center"></div>
      </div>

      <div class="lieux-grid">
        <div class="lieu-card" data-animate>
          <div class="lieu-logo">
            <img src="/logos-partenaires/la-halle-tropisme.png" alt="La Halle Tropisme" />
          </div>
          <h3>La Halle Tropisme</h3>
          <p>Ateliers cuisine</p>
        </div>
        <div class="lieu-card" data-animate>
          <div class="lieu-logo">
            <img src="/logos-partenaires/la-croix-rouge.png" alt="La Croix Rouge" />
          </div>
          <h3>La Croix Rouge</h3>
        </div>
        <div class="lieu-card" data-animate>
          <div class="lieu-logo">
            <img src="/logos-partenaires/la-prairie-mimosa.jpg" alt="Le Tuckshop de La Prairie Mimosa" />
          </div>
          <h3>La Prairie Mimosa-Tuck Shop</h3>
        </div>
        <div class="lieu-card" data-animate>
          <div class="lieu-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 21h18M5 21V7l8-4v18M13 21V3l6 4v14"/>
              <path d="M9 9h1M9 13h1M9 17h1"/>
            </svg>
          </div>
          <h3>C.E.I.S.</h3>
        </div>
        <div class="lieu-card" data-animate>
          <div class="lieu-logo">
            <img src="/logos-partenaires/mpt-montpellier.png" alt="Maisons pour Tous" />
          </div>
          <h3>MPT Voltaire</h3>
          <p>Ateliers couture</p>
        </div>
        <div class="lieu-card" data-animate>
          <div class="lieu-logo">
            <img src="/logos-partenaires/mpt-montpellier.png" alt="Maisons pour Tous" />
          </div>
          <h3>MPT Frédéric Chopin</h3>
          <p>Français interculturel</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partenaires actuels -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-terracotta">Aujourd'hui</span>
        <h2>Partenaires actuels</h2>
        <div class="divider divider-center"></div>
      </div>

      <div class="logos-grid" data-animate>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/kodiko.png" alt="Kodiko" />
          </div>
          <span>Kodiko</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/aliore.png" alt="ALIORE" />
          </div>
          <span>ALIORE</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/groupe-sos.png" alt="Groupe SOS" />
          </div>
          <span>CADA Elisa (groupe SOS)</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/forum-refugies.png" alt="Forum Réfugiés-Cosi" />
          </div>
          <span>Forum Réfugiés-Cosi (Agir 34 + SAFIR)</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/la-cimade.svg" alt="La Cimade" />
          </div>
          <span>La Cimade</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/la-croix-rouge.png" alt="La Croix Rouge" />
          </div>
          <span>La Croix Rouge Insertion</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/metropole-de-montpellier.svg" alt="Métropole de Montpellier" />
          </div>
          <span>Les 4 saisons de l'Agroécologie</span>
        </div>
        <div class="logo-card">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/le-mouvement-du-nid.jpg" alt="Le mouvement du nid" />
          </div>
          <span>Le mouvement du nid</span>
        </div>
        <div class="logo-card logo-card-text">
          <span class="logo-placeholder">P&C</span>
          <span>Passerelle et compétences</span>
        </div>
      </div>

      <div class="en-construction" data-animate>
        <span class="label label-sage">En construction</span>
        <p>L'Estanc <span class="en-construction-detail">— accueil d'urgence mineurs isolés</span></p>
      </div>
    </div>
  </section>

  <!-- Partenaires financiers passés -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-gold">Soutiens financiers</span>
        <h2>Partenaires financiers passés</h2>
        <div class="divider divider-center"></div>
      </div>

      <div class="financiers-grid" data-animate>
        <div class="financier-card">
          <div class="financier-logo">
            <img src="/logos-partenaires/region-citoyenne.png" alt="Région Citoyenne" />
          </div>
          <h3>Région Citoyenne</h3>
          <span class="financier-period">2020 – 2021</span>
        </div>
        <div class="financier-card">
          <div class="financier-logo">
            <img src="/logos-partenaires/ddets.png" alt="DDETS" />
          </div>
          <h3>DDETS34</h3>
          <span class="financier-period">2023 – 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Autres partenaires passés -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header" data-animate>
        <span class="label label-terracotta">Notre histoire partenariale</span>
        <h2>Autres partenaires passés</h2>
        <div class="divider divider-center"></div>
      </div>

      <div class="logos-grid logos-grid-past" data-animate>
        <div class="logo-card logo-card-past">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/forum-refugies.png" alt="Forum Réfugiés-Cosi" />
          </div>
          <span>Forum Réfugiés-Cosi / Agir 34</span>
        </div>
        <div class="logo-card logo-card-past">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/face-herault.png" alt="Face Hérault" />
          </div>
          <span>Face Hérault</span>
        </div>
        <div class="logo-card logo-card-past">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/refugee-food-festival.webp" alt="Refugee Food Festival" />
          </div>
          <span>Refugee Food Festival</span>
        </div>
        <div class="logo-card logo-card-past">
          <div class="logo-wrapper">
            <img src="/logos-partenaires/cdc-habitat.png" alt="CDC Habitat" />
          </div>
          <span>CDC Habitat</span>
        </div>
      </div>

      <div class="partenaires-grid partenaires-grid-past" data-animate>
        <span class="partenaire-tag partenaire-past">C.E.I.S.</span>
        <span class="partenaire-tag partenaire-past">Des Étoiles et des Femmes</span>
        <span class="partenaire-tag partenaire-past">Shake Mama</span>
        <span class="partenaire-tag partenaire-past">Entre et Avec</span>
        <span class="partenaire-tag partenaire-past">Radio Divergence</span>
        <span class="partenaire-tag partenaire-past">RadioFM+</span>
        <span class="partenaire-tag partenaire-past">Brand à part</span>
        <span class="partenaire-tag partenaire-past">F.A.S.</span>
        <span class="partenaire-tag partenaire-past">Yeobi</span>
        <span class="partenaire-tag partenaire-past">C.R.I.A.</span>
        <span class="partenaire-tag partenaire-past">C.H.R.S. FARE Castelnau</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card" data-animate>
        <h2>Devenir partenaire</h2>
        <p>Vous souhaitez collaborer avec Blablacooks ? Contactez-nous pour explorer les possibilités de partenariat.</p>
        <a href="/contact" class="btn btn-primary">Nous contacter</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .page-hero {
    position: relative;
    padding: calc(var(--space-3xl) + 2rem) 0 var(--space-2xl);
    overflow: hidden;
  }

  .hero-content {
    max-width: 700px;
    text-align: center;
    margin: 0 auto;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--color-brown);
    line-height: 1.8;
    margin-top: var(--space-md);
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: var(--color-terracotta);
    top: -200px;
    right: -150px;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: var(--color-gold);
    bottom: -100px;
    left: -100px;
  }

  /* Sections */
  .section {
    padding: var(--space-2xl) 0;
  }

  .section-warm {
    background: var(--color-cream-dark);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    margin-top: var(--space-sm);
  }

  .divider-center {
    width: 60px;
    height: 3px;
    background: var(--color-gold);
    border-radius: 2px;
    margin: var(--space-md) auto 0;
  }

  /* Lieux d'accueil */
  .lieux-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    max-width: 900px;
    margin: 0 auto;
  }

  .lieu-card {
    background: white;
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-md);
    text-align: center;
    box-shadow: var(--shadow-soft);
    transition: all 0.3s var(--ease-out-expo);
  }

  .lieu-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
  }

  .lieu-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-cream-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
    color: var(--color-terracotta);
  }

  .lieu-logo {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .lieu-logo img {
    max-height: 50px;
    max-width: 120px;
    object-fit: contain;
  }

  .lieu-card h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .lieu-card p {
    font-size: 0.85rem;
    color: var(--color-brown);
    opacity: 0.7;
  }

  /* Logo grid - partenaires avec logos */
  .logos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    max-width: 960px;
    margin: 0 auto;
  }

  .logo-card {
    background: white;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-soft);
    transition: all 0.3s var(--ease-out-expo);
  }

  .logo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
  }

  .logo-card .logo-wrapper {
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm);
  }

  .logo-card img {
    max-height: 100%;
    max-width: 150px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
  }

  .logo-card:hover img {
    filter: grayscale(0%);
  }

  .logo-card span {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-brown);
    text-align: center;
    line-height: 1.4;
  }

  .logo-card-text .logo-placeholder {
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-terracotta);
    background: var(--color-cream-dark);
    border-radius: var(--radius-sm);
  }

  /* Past logo cards */
  .logos-grid-past {
    margin-bottom: var(--space-lg);
    grid-template-columns: repeat(4, 1fr);
  }

  .logo-card-past {
    background: var(--color-cream);
  }

  .logo-card-past .logo-wrapper {
    height: 60px;
  }

  .logo-card-past img {
    filter: grayscale(40%);
    opacity: 0.8;
  }

  .logo-card-past:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .logo-card-past span {
    font-size: 0.8rem;
  }

  /* Partenaires tags (sans logo) */
  .partenaires-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    max-width: 900px;
    margin: 0 auto;
  }

  .partenaire-tag {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    background: white;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-brown-dark);
    box-shadow: var(--shadow-soft);
    transition: all 0.3s ease;
  }

  .partenaire-tag:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
    color: var(--color-terracotta);
  }

  .partenaire-past {
    background: var(--color-cream);
    opacity: 0.85;
  }

  .partenaire-past:hover {
    opacity: 1;
  }

  /* En construction */
  .en-construction {
    text-align: center;
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background: white;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    border-left: 4px solid var(--color-sage);
  }

  .en-construction .label {
    margin-bottom: var(--space-xs);
  }

  .en-construction p {
    font-weight: 500;
    color: var(--color-brown-dark);
  }

  .en-construction-detail {
    font-weight: 400;
    color: var(--color-brown);
    opacity: 0.7;
  }

  .label-sage {
    background: var(--color-sage-light);
    color: var(--color-sage);
  }

  /* Financiers */
  .financiers-grid {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
  }

  .financier-card {
    flex: 1;
    background: white;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-align: center;
    box-shadow: var(--shadow-soft);
    border-top: 3px solid var(--color-gold);
  }

  .financier-logo {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }

  .financier-logo img {
    max-height: 50px;
    max-width: 140px;
    object-fit: contain;
  }

  .financier-card h3 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .financier-period {
    font-size: 0.9rem;
    color: var(--color-brown);
    opacity: 0.6;
  }

  /* CTA */
  .cta-section {
    padding-bottom: var(--space-3xl);
  }

  .cta-card {
    text-align: center;
    background: var(--color-brown-dark);
    color: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
  }

  .cta-card h2 {
    color: var(--color-cream);
    margin-bottom: var(--space-sm);
  }

  .cta-card p {
    max-width: 500px;
    margin: 0 auto var(--space-lg);
    opacity: 0.8;
    line-height: 1.7;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .lieux-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .logos-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .logos-grid-past {
      grid-template-columns: repeat(2, 1fr);
    }

    .financiers-grid {
      flex-direction: column;
      align-items: center;
    }

    .financier-card {
      width: 100%;
      max-width: 300px;
    }
  }

  @media (max-width: 480px) {
    .lieux-grid {
      grid-template-columns: 1fr;
    }

    .logos-grid,
    .logos-grid-past {
      grid-template-columns: 1fr;
    }
  }
</style>
